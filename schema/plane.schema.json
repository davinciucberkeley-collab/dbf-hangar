{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/REPLACE_ME/aircraft-platform/schema/plane.schema.json",
  "title": "Plane Design Language v1.3",
  "description": "Canonical design file. Units are fixed: millimetres, grams, newtons, degrees, seconds. Body frame: origin at the nose datum, +x aft, +y starboard (right), +z up.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "status",
    "morphology",
    "root",
    "components",
    "attachments"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "0.1",
        "0.2",
        "0.3",
        "0.4",
        "1.0",
        "1.1",
        "1.2",
        "1.3"
      ],
      "description": "0.2 adds optional attachment.articulation and flight.hover_pose / flight.cruise_pose; 0.3 adds optional component.cavities; 0.4 adds the point_mass geometry (mass at a point, no extent), attachment.kinematic_link, attachment.rating_basis and component.planform; 0.1-0.3 files validate unchanged. 1.0 adds the optional blocks files, bom, wiring, mechanisms, transport, assembly, component.provenance and requirements.transport_box_mm (PDL v1.0, docs/pdl/reference.md); 0.1-0.4 files validate unchanged. 1.0 also adds the optional attachment.connection and attachment.seat and the D21 gate inputs (component.battery, propulsion.max_current_a, propulsion.prop_diameter_mm, flight.cruise_ld, flight.transition_speed_mps with their `_source` fields). 1.1 adds the optional motor fields propulsion.spin, propulsion.torque_per_thrust_m and propulsion.torque_per_thrust_m_source (prop reaction torque, used by the yaw row of T3.control_authority); 0.1-1.0 files validate unchanged. 1.2 adds optional geometry generators (component.geometry {generator, params}), the design-level parameters block with \"$name\" references in geometry params, planform, position and rotation_deg, and component.mass_model (mass from generated volume x density, instead of mass_g); 0.1-1.1 files validate unchanged. 1.3 adds the optional mechanisms[].kinematics (ratio or four_bar: the follower angle and the rod pose are solved from the linkage geometry); 0.1-1.2 files validate unchanged."
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "concept",
        "designed",
        "built",
        "flown",
        "retired"
      ]
    },
    "description": {
      "type": "string"
    },
    "lineage": {
      "description": "Design ids this one was derived from, and knowledge-base entries that inspired it.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "derived_from": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "inspired_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "morphology": {
      "description": "Tags matching the morphological chart in knowledge/morphological-chart.yaml.",
      "type": "object",
      "required": [
        "lift",
        "vtol_method"
      ],
      "additionalProperties": false,
      "properties": {
        "lift": {
          "enum": [
            "fixed-wing",
            "flying-wing",
            "multirotor",
            "lifting-body",
            "biplane",
            "box-wing",
            "other"
          ]
        },
        "vtol_method": {
          "enum": [
            "none",
            "tailsitter",
            "tiltrotor",
            "tiltwing",
            "lift-plus-cruise",
            "ducted-fan",
            "other"
          ]
        },
        "tail": {
          "enum": [
            "conventional",
            "v-tail",
            "t-tail",
            "canard",
            "none",
            "other"
          ]
        },
        "propulsion_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mtow_g": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "payload_g": {
          "type": "number",
          "minimum": 0
        },
        "cruise_speed_mps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "stall_speed_max_mps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "endurance_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "budget_usd": {
          "type": "number",
          "minimum": 0
        },
        "transport_box_mm": {
          "description": "v1.0. Transport box inner size [length, width, height] in mm.",
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "mission": {
      "description": "v1.0. What this design is for. Numbers the gates judge against stay in `requirements` and `flight`.",
      "type": "object",
      "required": [
        "name",
        "profile"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "enum": [
            "vtol-demonstrator",
            "scale-model",
            "trainer",
            "utility",
            "other"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "reference_aircraft": {
          "type": "string",
          "minLength": 1,
          "description": "The real aircraft a scale model copies, e.g. 'Airbus A400M'."
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "repo-relative path of the knowledge/ entry that states the mission."
        }
      }
    },
    "flight": {
      "description": "Operating point used by tier-3 checks.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cl_max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1.1
        },
        "air_density_kgm3": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1.225
        },
        "hover_pose": {
          "type": "string",
          "description": "v0.2. Articulation pose name used for tier-2 hover moment and hover T/W."
        },
        "cruise_pose": {
          "type": "string",
          "description": "v0.2. Articulation pose name used for tier-3 aero (stall, static margin)."
        },
        "cruise_ld": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cruise_ld_source": {
          "type": "string",
          "minLength": 1
        },
        "transition_speed_mps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "transition_speed_source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "root": {
      "description": "Component id that every other component must connect to through attachments.",
      "$ref": "#/$defs/slug"
    },
    "materials": {
      "type": "object",
      "description": "Material id -> properties. Ids may also refer to standards/materials.yaml.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "density_g_cm3": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attachment"
      }
    },
    "files": {
      "$ref": "#/$defs/files"
    },
    "bom": {
      "$ref": "#/$defs/bom"
    },
    "wiring": {
      "$ref": "#/$defs/wiring"
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "description": "v1.3, optional. Switches for derived, visual-only geometry in the GLB and Studio (never components: no mass, no checks).",
      "properties": {
        "clevises": {
          "type": "boolean",
          "description": "v1.3. Draw a clevis (barrel and cross pin) at both ends of the pushrod of every mechanism that has a link."
        }
      }
    },
    "mechanisms": {
      "description": "v1.0. Pull-this-moves-that checks between attachments.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/mechanism"
      }
    },
    "transport": {
      "$ref": "#/$defs/transport"
    },
    "assembly": {
      "$ref": "#/$defs/assembly"
    },
    "notes": {
      "type": "string"
    },
    "parameters": {
      "type": "object",
      "description": "v1.2. Named numbers that component geometry.params, planform, position and rotation_deg may reference as the string \"$name\". Change one with `plane design set parameters.<name> <value>`.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "number"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "type",
        "geometry",
        "position"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "type": {
          "enum": [
            "fuselage",
            "wing",
            "tail_surface",
            "boom",
            "motor",
            "propeller",
            "battery",
            "esc",
            "flight_controller",
            "receiver",
            "servo",
            "payload",
            "landing_gear",
            "structure",
            "pod",
            "other"
          ]
        },
        "description": {
          "type": "string"
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        },
        "planform": {
          "description": "v0.4. Aerodynamic planform of a component whose geometry is not a lifting_surface (e.g. a mesh wing). Used ONLY by tier-3 aero (lift slope, stall, static margin, neutral point). It creates no geometry for collision, mass or export. Not allowed on a component whose geometry is a lifting_surface.",
          "type": "object",
          "required": [
            "lifting_surface",
            "origin"
          ],
          "additionalProperties": false,
          "properties": {
            "lifting_surface": {
              "$ref": "#/$defs/lifting_surface"
            },
            "origin": {
              "description": "Body-frame position of the root leading edge (mm).",
              "$ref": "#/$defs/vec3"
            },
            "rotation_deg": {
              "description": "Intrinsic roll, pitch, yaw of the planform about x, y, z (deg). Default [0,0,0].",
              "$ref": "#/$defs/vec3",
              "default": [
                0,
                0,
                0
              ]
            }
          }
        },
        "position": {
          "description": "Component origin in body frame (mm). For box/cylinder: centre. For lifting_surface: root leading edge. For point_mass (v0.4): the point where the mass sits.",
          "$ref": "#/$defs/vec3"
        },
        "rotation_deg": {
          "description": "Intrinsic roll, pitch, yaw about x, y, z (deg).",
          "$ref": "#/$defs/vec3"
        },
        "mass_g": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cg_offset": {
          "description": "CG relative to the component's geometric centroid (mm). Default [0,0,0].",
          "$ref": "#/$defs/vec3"
        },
        "material": {
          "type": "string"
        },
        "cavities": {
          "description": "v0.3. Solid box or cylinder shapes subtracted from the component's local mesh before rotation_deg is applied. A cavity may break through the outer surface (an opening).",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/cavity"
          }
        },
        "manufacturing": {
          "type": "object",
          "required": [
            "method"
          ],
          "additionalProperties": false,
          "properties": {
            "method": {
              "enum": [
                "laser-cut",
                "3d-print-fdm",
                "3d-print-sla",
                "cnc-router",
                "cnc-mill",
                "hotwire-foam",
                "foamboard",
                "composite-layup",
                "waterjet",
                "hand-cut",
                "purchased"
              ]
            },
            "machine": {
              "type": "string",
              "description": "Optional machine id from standards/manufacturing.yaml"
            },
            "part_number": {
              "type": "string",
              "description": "For purchased parts"
            },
            "cost_usd": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "propulsion": {
          "type": "object",
          "description": "Motors only.",
          "required": [
            "max_thrust_n",
            "axis"
          ],
          "additionalProperties": false,
          "properties": {
            "max_thrust_n": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "const": "pending"
                }
              ],
              "description": "Peak static thrust, N, from a datasheet or bench test; the text pending when no source exists (checks that need it are skipped)."
            },
            "axis": {
              "description": "Direction of the thrust FORCE on the aircraft (unit vector, body frame). Forward thrust is [-1,0,0] for tractors and pushers alike; hover lift at 0 deg pose is [0,0,1].",
              "$ref": "#/$defs/vec3"
            },
            "role": {
              "enum": [
                "lift",
                "cruise",
                "both"
              ]
            },
            "max_current_a": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "peak current at max_thrust_n, from a datasheet or bench test"
            },
            "prop_diameter_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "spin": {
              "enum": [
                "cw",
                "ccw"
              ],
              "description": "PDL 1.1. Sense of rotation of the prop seen from the side the thrust force points to, looking back at the motor (a hover lift motor: seen from above). The reaction torque on the airframe about the thrust axis is the opposite way: a cw prop adds +axis, a ccw prop -axis."
            },
            "torque_per_thrust_m": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "PDL 1.1. Prop reaction torque per unit thrust (N*m per N, a length in metres; measured or from the prop data). Needs spin and torque_per_thrust_m_source."
            },
            "torque_per_thrust_m_source": {
              "type": "string",
              "minLength": 1,
              "description": "PDL 1.1. Where torque_per_thrust_m comes from (document, test or plant file with its line)."
            }
          }
        },
        "battery": {
          "type": "object",
          "description": "PDL 1.0 (D21). Battery components only.",
          "required": [
            "capacity_mah",
            "cells_s"
          ],
          "additionalProperties": false,
          "properties": {
            "capacity_mah": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "cells_s": {
              "type": "integer",
              "minimum": 1
            },
            "max_discharge_c": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "mass_model": {
          "type": "object",
          "additionalProperties": false,
          "description": "v1.2. Mass computed from the generated geometry: volume x density + extra_g. Use instead of mass_g (giving both is an error). Only for a component whose geometry is a generator.",
          "properties": {
            "material": {
              "type": "string",
              "description": "Id of an entry of the design's materials block or of standards/materials.yaml."
            },
            "density_g_cm3": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "extra_g": {
              "type": "number",
              "minimum": 0,
              "default": 0,
              "description": "Mass not in the volume (glue, tape, hardware), grams."
            }
          },
          "oneOf": [
            {
              "required": [
                "material"
              ]
            },
            {
              "required": [
                "density_g_cm3"
              ]
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "motor"
              }
            }
          },
          "then": {
            "required": [
              "propulsion"
            ]
          }
        },
        {
          "anyOf": [
            {
              "required": [
                "mass_g"
              ]
            },
            {
              "required": [
                "mass_model"
              ]
            }
          ]
        },
        {
          "not": {
            "required": [
              "mass_g",
              "mass_model"
            ]
          }
        }
      ]
    },
    "cavity": {
      "type": "object",
      "required": [
        "geometry",
        "position"
      ],
      "additionalProperties": false,
      "properties": {
        "geometry": {
          "description": "Box or cylinder only (v0.3).",
          "oneOf": [
            {
              "type": "object",
              "required": [
                "box"
              ],
              "additionalProperties": false,
              "properties": {
                "box": {
                  "type": "object",
                  "required": [
                    "size"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "size": {
                      "description": "[lx, ly, lz] mm",
                      "$ref": "#/$defs/vec3"
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "cylinder"
              ],
              "additionalProperties": false,
              "properties": {
                "cylinder": {
                  "type": "object",
                  "required": [
                    "radius",
                    "length"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "radius": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "length": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "axis": {
                      "enum": [
                        "x",
                        "y",
                        "z"
                      ],
                      "default": "x"
                    }
                  }
                }
              }
            }
          ]
        },
        "position": {
          "description": "Cavity centre relative to the component's position, in the component's local frame (before rotation_deg).",
          "$ref": "#/$defs/vec3"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "geometry": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "box"
          ],
          "additionalProperties": false,
          "properties": {
            "box": {
              "type": "object",
              "required": [
                "size"
              ],
              "additionalProperties": false,
              "properties": {
                "size": {
                  "description": "[lx, ly, lz] mm",
                  "$ref": "#/$defs/vec3"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "cylinder"
          ],
          "additionalProperties": false,
          "properties": {
            "cylinder": {
              "type": "object",
              "required": [
                "radius",
                "length"
              ],
              "additionalProperties": false,
              "properties": {
                "radius": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "length": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "axis": {
                  "enum": [
                    "x",
                    "y",
                    "z"
                  ],
                  "default": "x"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "lifting_surface"
          ],
          "additionalProperties": false,
          "properties": {
            "lifting_surface": {
              "$ref": "#/$defs/lifting_surface"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "mesh"
          ],
          "additionalProperties": false,
          "properties": {
            "mesh": {
              "type": "object",
              "required": [
                "file"
              ],
              "additionalProperties": false,
              "properties": {
                "file": {
                  "type": "string",
                  "description": "STL/OBJ/GLB path relative to the design file, in mm."
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "point_mass"
          ],
          "additionalProperties": false,
          "properties": {
            "point_mass": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "distributed": {
                  "type": "boolean",
                  "default": false,
                  "description": "v0.4. Mass of items spread over the aircraft (harness, hardware) lumped at their combined CG, which may lie in open space. Its position must lie inside the aircraft's envelope (convex hull of all non-propeller geometry), not within attach_tolerance_mm of a host. Only for component type other, and limited by standards geometry.distributed_mass_max_fraction_each / _total."
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "description": "v0.4. Why this mass is distributed rather than modelled. Required when distributed is true."
                }
              },
              "if": {
                "properties": {
                  "distributed": {
                    "const": true
                  }
                },
                "required": [
                  "distributed"
                ]
              },
              "then": {
                "required": [
                  "reason"
                ]
              },
              "description": "v0.4. Mass with no extent (a lumped hardware or harness allowance). Counted in mass and CG at `position` (+ cg_offset); never in collision, contact, interference, drop-test collision or machine-fit checks."
            }
          }
        },
        {
          "type": "object",
          "required": [
            "generator"
          ],
          "additionalProperties": false,
          "properties": {
            "generator": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "description": "v1.2. Name of a registered geometry generator (hangar.geom registry: wing_panel, tube, fin, plate, fuselage_loft, motor_mount, mesh_file, library_part, nacelle, propeller, strut, landing_gear, wheel, tail_surfaces)."
            },
            "params": {
              "type": "object",
              "description": "v1.2. Generator parameters in mm and degrees; any number may be the string \"$name\" naming an entry of the design-level parameters block."
            }
          }
        }
      ]
    },
    "attachment": {
      "type": "object",
      "required": [
        "parent",
        "child",
        "method",
        "location",
        "rated_load_n"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "parent": {
          "$ref": "#/$defs/slug"
        },
        "child": {
          "$ref": "#/$defs/slug"
        },
        "method": {
          "enum": [
            "bolted",
            "glued",
            "press-fit",
            "magnet",
            "hinge",
            "zip-tie",
            "tape",
            "printed-integral",
            "clamp",
            "slot-tab"
          ]
        },
        "location": {
          "description": "Joint point in body frame (mm). Must lie on or inside both parts (within tolerance).",
          "$ref": "#/$defs/vec3"
        },
        "embed_ok": {
          "type": "boolean",
          "default": false,
          "description": "true if the child is meant to pass into the parent (spar into slot, motor into pod)."
        },
        "kinematic_link": {
          "type": "boolean",
          "default": false,
          "description": "v0.4. true if the child is moved by a linkage the schema does not model (e.g. a servo pushrod driven by an elevon horn). Tier-1 pose and sweep interference skips pairs of this child with a part moved by that pose and reports them as one WARN per pose (T1.kinematic_link). Static (0 deg) checks are unchanged."
        },
        "hinge_from": {
          "const": "generator",
          "description": "v1.2, optional. generator = the resolved location, articulation.pivot and articulation.axis come from the child's wing_panel hinge line (part elevon, side left or right) and follow its parameters; the values written here are a placeholder. An aileron, flap or elevon hinge follows a wing change this way."
        },
        "rated_load_n": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rating_basis": {
          "description": "v0.4. Where rated_load_n comes from. sourced: a published or tested capacity. derived: an allowable times measured geometry. placeholder: no capacity in the source; the value is not a capacity, and tier-2 load checks skip this joint (never PASS or FAIL it).",
          "enum": [
            "sourced",
            "derived",
            "placeholder"
          ]
        },
        "articulation": {
          "description": "v0.2. The joint moves. Rotation applies to the CHILD side: the child and everything attached downstream of it (reached from the child without crossing back through this joint). 0 deg = the geometry as written.",
          "type": "object",
          "required": [
            "type",
            "pivot",
            "axis"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "revolute"
                  }
                }
              },
              "then": {
                "required": [
                  "range_deg"
                ]
              },
              "else": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "range_deg"
                      ]
                    },
                    {
                      "required": [
                        "poses"
                      ]
                    }
                  ]
                }
              }
            }
          ],
          "properties": {
            "type": {
              "enum": [
                "revolute",
                "continuous"
              ],
              "description": "v1.3: type continuous = spins without limit (a wheel on its axle); no range_deg, no poses."
            },
            "pivot": {
              "description": "A point on the rotation axis, body frame (mm), at 0 deg.",
              "$ref": "#/$defs/vec3"
            },
            "axis": {
              "description": "Rotation axis direction (right-hand rule), body frame, at 0 deg.",
              "$ref": "#/$defs/vec3"
            },
            "range_deg": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "[min, max] angle in degrees."
            },
            "poses": {
              "type": "object",
              "description": "Named poses -> angle in degrees (each within range_deg).",
              "additionalProperties": {
                "type": "number"
              }
            }
          }
        },
        "connection": {
          "type": "string",
          "pattern": "^CT-[A-Z0-9-]+$",
          "description": "v1.0. Id of a connection type in standards/connection-types.yaml (for example CT-M3-SHCS-INSERT). Optional. T1.interfaces.connection_known fails an id that is not in the library."
        },
        "seat": {
          "type": "string",
          "minLength": 1,
          "description": "v1.0. Optional. Short text naming the recess, pocket or slot machined in the parent that receives the child (for example \"pod recess cut in the core\"). Data only; no check reads it."
        }
      }
    },
    "lifting_surface": {
      "type": "object",
      "required": [
        "span",
        "root_chord",
        "tip_chord"
      ],
      "additionalProperties": false,
      "properties": {
        "span": {
          "description": "Full span tip to tip if mirrored, else root to tip (mm).",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "root_chord": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tip_chord": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sweep_le_deg": {
          "type": "number",
          "default": 0
        },
        "dihedral_deg": {
          "type": "number",
          "default": 0
        },
        "thickness_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.4,
          "default": 0.12
        },
        "airfoil": {
          "type": "string"
        },
        "mirrored": {
          "type": "boolean",
          "default": true,
          "description": "true: symmetric about the component's x-z plane. false: extends toward +y (use rotation for vertical fins)."
        },
        "lifting": {
          "type": "boolean",
          "default": true,
          "description": "false for vertical fins (excluded from lift/neutral-point estimate)."
        }
      }
    },
    "relpath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!(.*/)?\\.\\.(/|$)).+$",
      "description": "v1.0. Path relative to the design folder, forward slashes only: no drive letter, no leading slash, no backslash, no .. segment."
    },
    "file_ref": {
      "description": "v1.0. A file in the design folder.",
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relpath"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "cad_file": {
      "description": "v1.0. A CAD file: source or derived.",
      "type": "object",
      "required": [
        "path",
        "format",
        "role"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relpath"
        },
        "format": {
          "enum": [
            "step",
            "f3d",
            "stl",
            "glb"
          ]
        },
        "role": {
          "enum": [
            "source",
            "derived"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "files": {
      "description": "v1.0. Files that belong to the design, relative to the design folder.",
      "type": "object",
      "properties": {
        "cad": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cad_file"
          }
        },
        "drawings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file_ref"
          }
        },
        "photos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file_ref"
          }
        }
      },
      "additionalProperties": false
    },
    "bom_verified": {
      "description": "v1.0. Who verified a BOM line, when and how.",
      "type": "object",
      "required": [
        "by",
        "date",
        "method"
      ],
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Quote the date in YAML so it stays a string."
        },
        "method": {
          "enum": [
            "browser",
            "datasheet",
            "in-hand",
            "webfetch"
          ]
        },
        "evidence": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "bom_item": {
      "description": "v1.0. One bill-of-materials line.",
      "type": "object",
      "required": [
        "id",
        "qty"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "component_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "part_number": {
          "type": "string"
        },
        "supplier": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "qty": {
          "type": "integer",
          "minimum": 1
        },
        "unit_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "mass_g": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "verified": {
          "$ref": "#/$defs/bom_verified"
        },
        "library_part": {
          "$ref": "#/$defs/slug",
          "description": "id of a knowledge/parts/ entry; T8 checks it exists."
        }
      },
      "additionalProperties": false
    },
    "bom": {
      "description": "v1.0. Bill of materials.",
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bom_item"
          }
        }
      },
      "additionalProperties": false
    },
    "harness": {
      "description": "v1.0. One wire harness between two components.",
      "type": "object",
      "required": [
        "id",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "from": {
          "$ref": "#/$defs/slug"
        },
        "to": {
          "$ref": "#/$defs/slug"
        },
        "route": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "gauge_awg": {
          "type": "integer",
          "minimum": 1
        },
        "from_port": {
          "$ref": "#/$defs/slug",
          "description": "v1.3. Name of a port in the library part of component `from` (knowledge/parts/<id>/part.yaml ports); the wire starts there. Default: the CG of `from`."
        },
        "to_port": {
          "$ref": "#/$defs/slug",
          "description": "v1.3. Name of a port in the library part of component `to` (knowledge/parts/<id>/part.yaml ports); the wire ends there. Default: the CG of `to`."
        },
        "waypoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vec3"
          },
          "description": "v1.3. Points (design frame, mm) the wire passes between its ends; [] = straight. Any of from_port, to_port, waypoints makes the harness routed: it is drawn as a tube in Studio and T7 checks the route."
        },
        "diameter_mm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "v1.3. Drawn wire diameter, mm (default 1.5). Visual only."
        },
        "exposed_ok": {
          "type": "object",
          "required": [
            "reason"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "wiring": {
      "description": "v1.0. Wiring harnesses.",
      "type": "object",
      "required": [
        "harnesses"
      ],
      "properties": {
        "harnesses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/harness"
          }
        }
      },
      "additionalProperties": false
    },
    "mechanism": {
      "description": "v1.0. A pull-this-moves-that mechanism between attachments.",
      "type": "object",
      "required": [
        "id",
        "driver",
        "driven"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "driver": {
          "type": "string",
          "description": "Attachment id."
        },
        "kinematics": {
          "enum": [
            "ratio",
            "four_bar"
          ],
          "description": "v1.3, optional, default ratio. ratio = the follower angle is the declared expect ratio x input (as before). four_bar = the follower angle is solved so that the distance from the link.driver_end point on the arm to the link.follower_end point in the horn stays constant (rod length), and the rod is drawn pinned between them; needs link, exactly one driven attachment and the same attachment in expect; input_range_deg must contain 0."
        },
        "driven": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "input_range_deg": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "expect": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "attachment",
              "ratio"
            ],
            "properties": {
              "attachment": {
                "type": "string"
              },
              "ratio": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        "link": {
          "description": "v1.0. The linkage the schema does not otherwise model: the two attachments where it is pinned. driver_end is a kinematic_link attachment on the driver side (e.g. the pushrod on the servo arm); follower_end is an attachment on the side moved by the driven joint (e.g. the clevis pin in the horn). Their `location` points give the lever ratio checked by T6.ratio, and their parts are not counted as colliding with the driver-side linkage part (T6.link).",
          "type": "object",
          "required": [
            "driver_end",
            "follower_end"
          ],
          "properties": {
            "driver_end": {
              "type": "string",
              "description": "Attachment id."
            },
            "follower_end": {
              "type": "string",
              "description": "Attachment id."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "transport": {
      "description": "v1.0. Transport and disassembly groups.",
      "type": "object",
      "properties": {
        "disassembly": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "group",
              "component_ids"
            ],
            "properties": {
              "group": {
                "type": "string",
                "minLength": 1
              },
              "component_ids": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/slug"
                },
                "minItems": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "assembly_step": {
      "description": "v1.0. One assembly step.",
      "type": "object",
      "required": [
        "step",
        "add"
      ],
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 1
        },
        "add": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          },
          "minItems": 1
        },
        "tool": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "assembly": {
      "description": "v1.0. Assembly sequence.",
      "type": "object",
      "required": [
        "sequence"
      ],
      "properties": {
        "sequence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assembly_step"
          }
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "description": "v1.0. Where a component's mass and geometry numbers come from.",
      "type": "object",
      "properties": {
        "mass_source": {
          "enum": [
            "measured",
            "cad",
            "datasheet",
            "estimate"
          ]
        },
        "geometry_source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
